<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingClass"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundfc">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivSnow"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/snow"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:visibility="gone"/>
    </FrameLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_extra_bold"
        android:shadowColor="#E9D991"
        android:shadowDx="5"
        android:shadowDy="5"
        android:shadowRadius="5"
        android:text="FCalculator"
        android:textColor="#BC241F"
        android:textSize="40sp"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:alpha="0.60"
        android:fontFamily="@font/poppins_extra_bold"
        android:text="HelloWorld(“print”)"
        android:ellipsize="end"
        android:singleLine="true"
        android:gravity="end"
        android:layout_marginEnd="20dp"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/tvAnswer"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAnswer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:fontFamily="@font/poppins_extra_bold"
        android:text="91×12"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:alpha="0.45"
        app:layout_constraintBottom_toTopOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="350dp"
        android:layout_height="3dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.55"
        android:src="@drawable/line"
        app:layout_constraintBottom_toTopOf="@+id/llRow1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llRow1"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"
        app:layout_constraintBottom_toBottomOf="@id/llRow2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llClearAll"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:alpha="0.55"
            android:background="@drawable/background_button_red"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="C"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llBackspace"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:background="@drawable/background_button"
            android:alpha="0.55">

            <ImageView
                android:layout_width="31dp"
                android:layout_height="25dp"
                android:src="@drawable/backspace"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llPercent"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="%"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llDivision"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="÷"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llRow2"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"
        app:layout_constraintBottom_toBottomOf="@id/llRow3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llNumSeven"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="7"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llNumEight"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:background="@drawable/background_button"
            android:alpha="0.55">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="8"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llNumNine"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="9"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMultiply"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="×"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llRow3"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"
        app:layout_constraintBottom_toBottomOf="@id/llRow4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llNumFour"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="4"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llNumFive"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:background="@drawable/background_button"
            android:alpha="0.55">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="5"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llNumSix"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="6"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMinus"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="-"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llRow4"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"
        app:layout_constraintBottom_toBottomOf="@id/llRow5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llNumOne"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="1"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llNumTwo"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:background="@drawable/background_button"
            android:alpha="0.55">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="2"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llNumThree"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="3"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llPlus"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="+"
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/llRow5"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="75dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    <LinearLayout
        android:id="@+id/llNumZero"
        android:layout_width="170dp"
        android:layout_height="50dp"
        android:layout_gravity="right"
        android:alpha="0.55"
        android:background="@drawable/background_button"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:text="0"
            android:fontFamily="@font/poppins_extra_bold"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPoint"
        android:layout_width="75dp"
        android:layout_height="50dp"
        android:layout_gravity="right"
        android:layout_marginStart="20dp"
        android:alpha="0.55"
        android:background="@drawable/background_button"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:text="."
            android:fontFamily="@font/poppins_extra_bold"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:includeFontPadding="false" />
    </LinearLayout>

        <LinearLayout
            android:id="@+id/llEquals"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:alpha="0.55"
            android:background="@drawable/background_button_green"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="="
                android:fontFamily="@font/poppins_extra_bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
